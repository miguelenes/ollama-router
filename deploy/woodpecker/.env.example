# Copy to .env and fill in — never commit real values.
#
#   WOODPECKER_HOST      public/base URL of the server, e.g.
#                        http://192.168.1.50:8000 (or the LAN hostname)
#   WOODPECKER_GITHUB_*  GitHub OAuth App credentials (owner account,
#                        Settings -> Developer settings -> OAuth Apps);
#                        callback URL must be ${WOODPECKER_HOST}/authorize
#   WOODPECKER_AGENT_SECRET  shared secret between server and agent,
#                        e.g. `openssl rand -hex 32` (never commit)
WOODPECKER_HOST=http://127.0.0.1:8000
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=
WOODPECKER_AGENT_SECRET=
WOODPECKER_GRPC_SECRET=
# Closed registration once an admin exists. First-run local compose may
# leave OPEN=true; set ADMIN to your GitHub login.
WOODPECKER_OPEN=true
WOODPECKER_ADMIN=miguelenes
# Optional public URL for GitHub webhooks when WOODPECKER_HOST is loopback
# (GitHub rejects 127.0.0.1 hook targets). Example: Tailscale Funnel host.
# WOODPECKER_EXPERT_WEBHOOK_HOST=https://desktop.bicorn-beta.ts.net
