  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Volume",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "count_over_time on the same {container=\"router\"} | json stream. keep drops extra JSON keys (including model) before the metric so this is not a body scrape and does not label by model name. Alloy drop counters are not in Loki.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "min": 0,
          "unit": "ops"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "(?i)error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "(?i)warn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (level) (count_over_time({container=\"router\"} | json | label_format level=`{{.level}}`, node=`{{.node}}`, reason=`{{.reason}}`, path=`{{.path}}`, request_class=`{{.request_class}}` | keep level, node, reason, path, request_class | level=~\"(?i)(${level:regex})\" | node=~\"${node:regex}\" | reason=~\"$reason\" | path=~\"$path\" | request_class=~\"${request_class:regex}\" [1m]))",
          "legendFormat": "{{level}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Log lines by level",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 3,
      "title": "Logs",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Allowlisted fields only: timestamp, level, node, reason, request_id, path, request_class. Do not parse or display prompt, messages, body, embeddings, tokens, or secrets. Filters apply to JSON fields after | json (level is also an Alloy stream label).",
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "id": 4,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": false,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{container=\"router\"} | json | label_format level=`{{.level}}`, node=`{{.node}}`, reason=`{{.reason}}`, path=`{{.path}}`, request_class=`{{.request_class}}` | level=~\"(?i)(${level:regex})\" | node=~\"${node:regex}\" | reason=~\"$reason\" | path=~\"$path\" | request_class=~\"${request_class:regex}\" | line_format \"{{.timestamp}} {{.level}} node={{.node}} reason={{.reason}} request_id={{.request_id}} path={{.path}} request_class={{.request_class}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Router logs (allowlisted fields)",
      "type": "logs"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "ollama-router"
  ],
