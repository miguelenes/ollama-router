# Copy to .local/zrok/.env (gitignored). Never commit tokens.
# Used by the official zrok-instance compose that `task zrok:fetch` downloads.
# Docs: https://docs.zrok.io/docs/0.4/guides/self-hosting/docker/
#
# Local compose binds the controller API on loopback :18080.
# Point the router at it:
#   tunnel.api_endpoint: http://127.0.0.1:18080
#   tunnel.enable_token_env: ZROK_ENABLE_TOKEN
#   tunnel.access_bind: "127.0.0.1"
#
# Do not put enable tokens, share tokens, or admin bearers in this repo.

ZROK_DNS_ZONE=zrok.localhost
ZROK_USER_EMAIL=dev@localhost
ZROK_USER_PWD=
ZITI_PWD=
ZROK_ADMIN_TOKEN=
ZROK_INSECURE_INTERFACE=127.0.0.1
