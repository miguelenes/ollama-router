# Listen (container / binary). Compose publishes host 11435 → 11434.
OLLAMA_ROUTER_HOST=0.0.0.0
OLLAMA_ROUTER_PORT=11434

# Permanent fleet file (default /etc/ollama-router/fleet.yaml).
# OLLAMA_ROUTER_FLEET=/etc/ollama-router/fleet.yaml

# Optional tunables overlay (not inventory).
# OLLAMA_ROUTER_CONFIG=/etc/ollama-router/config.yaml

# tracing-subscriber env filter. JSON logs on stdout.
RUST_LOG=ollama_router=info

# Admin bearer for /router/v1/* (later). Unset → admin API disabled (403). No default.
# OLLAMA_ROUTER_ADMIN_TOKEN=
