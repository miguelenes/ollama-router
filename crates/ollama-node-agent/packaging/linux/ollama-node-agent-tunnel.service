[Unit]
Description=Ollama node agent zrok private share
After=network-online.target ollama.service ollama-node-agent.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=ollama-node-agent
SyslogIdentifier=ollama-node-agent-tunnel
Environment=HOME=/var/lib/ollama-node-agent
EnvironmentFile=-/etc/ollama-node-agent/env
ExecStart=/usr/local/bin/ollama-node-agent tunnel --config /etc/ollama-node-agent/config.yaml
Restart=on-failure
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
