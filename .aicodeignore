# AICode indexer extras (also respects .gitignore and .cursorignore)

# Index transaction scratch — not the committed segment view
.aicode/index/tmp/
.aicode/index/tmp/**

# Duplicate skill trees — keep .cursor/skills + .opencode/wiki indexed
.agents/skills/
.agents/skills/**
.opencode/skills/
.opencode/skills/**

# PromptWizard scratch / config (not product code)
prompt_drafts.md
.promptbooster.yml

# Belts-and-suspenders (already in .gitignore)
target/
target/**
.task/
.task/**

# Local IDE / secrets noise
.env
.env.*
*.pem
*.key
*.sqlite3
